{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // 테스트 전용 타입 환경 — Node API + vitest globals 허용
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-setup.ts",
    "src/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
