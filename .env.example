# KRX 세션 인증 정보 (SPEC-KRX-AUTH-001)
# data.krx.co.kr 회원 계정을 입력하세요.
# 이 파일을 .env로 복사한 후 값을 입력하세요: cp .env.example .env
KRX_ID=
KRX_PW=

# === SPEC-AI-REPORT-003: AI 리포트 (Codex CLI 기반, API 키 불필요) ===
# Codex CLI 는 ChatGPT 구독을 통해 인증됩니다. 별도 API 키를 입력할 필요 없이
# 터미널에서 `codex login` 으로 한 번만 로그인하면 됩니다.
# Fast Mode 는 Codex 를 사용하므로 PERPLEXITY_API_KEY 는 더 이상 필요하지 않습니다.

# AI 리포트 운영 옵션 (선택, 기본값 사용 권장)
# 하루 분석 횟수 제한은 없다(2026-10-21). 연속 요청 폭주만 막는다.
AI_REPORT_BURST_LIMIT=3      # 분당 최대 요청 수 (기본 3)

# === SPEC-AI-REPORT-004: Goose 분석 (Claude Code 구독 인증, API 키 불필요) ===
# 터미널에서 `claude` 로그인 상태면 됩니다. 서버 시작 시 하네스를 리포 밖 설치본에 설치합니다.
# Goose 분석 모델 (기본 sonnet)
AI_REPORT_GOOSE_MODEL=sonnet
# Goose 작업 1건의 시간 상한(초, 기본 900)
AI_REPORT_GOOSE_TIMEOUT=900
# 보존할 Goose 작업 폴더 수 (기본 10, 오래된 것부터 정리)
AI_REPORT_GOOSE_RUNS_KEEP=10
# 하네스 설치 위치 (기본 ~/.goose-harness). 리포 아래 경로는 거부됩니다.
# AI_REPORT_GOOSE_HARNESS_DIR=~/.goose-harness

# === SPEC-AI-REPORT-005: goose 실행 전 DART 원문 사전 수집 (기본 켜짐) ===
# 0이면 사전 수집을 끕니다. 요청 간격·횟수·시간 상한은 코드 상수라 환경 변수로 바꿀 수 없습니다.
# AI_REPORT_GOOSE_DART_PREFETCH=0
