# KRX 세션 인증 정보 (SPEC-KRX-AUTH-001)
# data.krx.co.kr 회원 계정을 입력하세요.
# 이 파일을 .env로 복사한 후 값을 입력하세요: cp .env.example .env
KRX_ID=
KRX_PW=

# === AI 리포트: Perplexity (기존, 선택사항) ===
PERPLEXITY_API_KEY=

# AI 리포트 운영 옵션 (선택, 기본값 사용 권장)
AI_REPORT_DAILY_QUOTA=50     # 하루 최대 분석 횟수 (기본 50)
AI_REPORT_BURST_LIMIT=3      # 분당 최대 요청 수 (기본 3)

# === SPEC-AI-REPORT-002 Deep Research ===
# Deep 모드 검색 API 키 (Deep 모드 사용 시 필수)
BRAVE_API_KEY=
TAVILY_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Deep 모드 운영 옵션 (선택, 기본값 사용 가능)
AI_REPORT_DEEP_DAILY_QUOTA=15
AI_REPORT_DEEP_BURST_LIMIT=1
AI_REPORT_DEEP_MODEL=sonnet
