# KRX 세션 인증 정보 (SPEC-KRX-AUTH-001)
# data.krx.co.kr 회원 계정을 입력하세요.
# 이 파일을 .env로 복사한 후 값을 입력하세요: cp .env.example .env
KRX_ID=
KRX_PW=

# === SPEC-AI-REPORT-003: AI 리포트 (Codex CLI 기반, API 키 불필요) ===
# Codex CLI 는 ChatGPT 구독을 통해 인증됩니다. 별도 API 키를 입력할 필요 없이
# 터미널에서 `codex login` 으로 한 번만 로그인하면 됩니다.
# Fast Mode + Deep Mode 둘 다 Codex 를 사용하므로 PERPLEXITY_API_KEY 는 더 이상 필요하지 않습니다.

# AI 리포트 운영 옵션 (선택, 기본값 사용 권장)
# SPEC-AI-REPORT-003: 쿼터는 ChatGPT 구독 일일 한도 보호 목적 (비용 한도 아님).
AI_REPORT_DAILY_QUOTA=50     # 하루 최대 분석 횟수 (기본 50)
AI_REPORT_BURST_LIMIT=3      # 분당 최대 요청 수 (기본 3)

# === SPEC-AI-REPORT-002 Deep Research 검색 API 키 ===
# Deep 모드는 Codex + Brave/Tavily/Naver/YouTube 5-소스 병렬 수집을 사용합니다.
BRAVE_API_KEY=
TAVILY_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Deep 모드 운영 옵션 (선택, 기본값 사용 가능)
AI_REPORT_DEEP_DAILY_QUOTA=15
AI_REPORT_DEEP_BURST_LIMIT=1
AI_REPORT_DEEP_MODEL=sonnet
